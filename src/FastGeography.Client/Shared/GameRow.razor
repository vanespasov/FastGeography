@using FastGeography.Shared;

<tr>
    <td class="table-light">
        <input @bind-value=@game.Letter disabled="true" style="width:35px;"
               aria-label="Game letter" />
    </td>
    <td class="@(game.SetCssClass(game.City!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.City.Answer
               aria-label="City starting with @game.Letter" style="width:120px;" />
        @if (game.City.MapsUri != null)
        {
            <a href="@game.City.MapsUri" target="_blank" rel="noopener noreferrer"
               aria-label="View @game.City.Answer on Bing Maps">
                <img src="images/visit.svg" alt="View on map" style="width:32px;height:32px;margin-left:4px;" />
            </a>
        }
    </td>
    <td class="@(game.SetCssClass(game.Village!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.Village.Answer
               aria-label="Village starting with @game.Letter" style="width:120px;" />
        @if (game.Village.MapsUri != null)
        {
            <a href="@game.Village.MapsUri" target="_blank" rel="noopener noreferrer"
               aria-label="View @game.Village.Answer on Bing Maps">
                <img src="images/visit.svg" alt="View on map" style="width:32px;height:32px;margin-left:4px;" />
            </a>
        }
    </td>
    <td class="@(game.SetCssClass(game.Country!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.Country.Answer
               aria-label="Country starting with @game.Letter" style="width:120px;" />
        @if (game.Country.MapsUri != null)
        {
            <a href="@game.Country.MapsUri" target="_blank" rel="noopener noreferrer"
               aria-label="View @game.Country.Answer on Bing Maps">
                <img src="images/visit.svg" alt="View on map" style="width:32px;height:32px;margin-left:4px;" />
            </a>
        }
    </td>
    <td class="@(game.SetCssClass(game.River!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.River.Answer
               aria-label="River starting with @game.Letter" style="width:120px;" />
        @if (game.River.MapsUri != null)
        {
            <a href="@game.River.MapsUri" target="_blank" rel="noopener noreferrer"
               aria-label="View @game.River.Answer on Bing Maps">
                <img src="images/visit.svg" alt="View on map" style="width:32px;height:32px;margin-left:4px;" />
            </a>
        }
    </td>
    <td class="@(game.SetCssClass(game.Mountain!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.Mountain.Answer
               aria-label="Mountain starting with @game.Letter" style="width:120px;" />
        @if (game.Mountain.MapsUri != null)
        {
            <a href="@game.Mountain.MapsUri" target="_blank" rel="noopener noreferrer"
               aria-label="View @game.Mountain.Answer on Bing Maps">
                <img src="images/visit.svg" alt="View on map" style="width:32px;height:32px;margin-left:4px;" />
            </a>
        }
    </td>
    <td class="table-light">@game.SecondsPlayed</td>
    <td class="table-light">
        <button @onclick="HandleClick"
                disabled=@(game.IsFinished || IsChecking)
                class="btn btn-primary"
                aria-label="Check answers for letter @game.Letter">
            Check
        </button>
    </td>
</tr>

@code {
    [Parameter] public EventCallback<Game> OnClick { get; set; }
    [Parameter] public Guid Id { get; set; }
    [Parameter] public DateTime DatePlayed { get; set; }
    [Parameter] public char Letter { get; set; }
    [Parameter] public GameLocation? City { get; set; }
    [Parameter] public GameLocation? Village { get; set; }
    [Parameter] public GameLocation? Country { get; set; }
    [Parameter] public GameLocation? Mountain { get; set; }
    [Parameter] public GameLocation? River { get; set; }
    [Parameter] public bool IsFinished { get; set; }
    [Parameter] public bool IsChecking { get; set; }
    [Parameter] public int SecondsPlayed { get; set; }

    private Game game = new();

    private async Task HandleClick() => await OnClick.InvokeAsync(game);

    protected override void OnParametersSet()
    {
        game = new Game
        {
            Id = Id,
            DatePlayed = DatePlayed,
            Letter = Letter,
            City = City,
            Village = Village,
            Country = Country,
            Mountain = Mountain,
            River = River,
            IsFinished = IsFinished,
            SecondsPlayed = SecondsPlayed
        };
    }
}
