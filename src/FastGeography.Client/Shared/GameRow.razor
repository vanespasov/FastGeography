@using FastGeography.Shared
@inject IStringLocalizer<UiStrings> L

<tr>
    <td class="table-light">
        <input @bind-value=@game.Letter disabled="true" style="width:35px;"
               aria-label="@L["GameRow_GameLetter"]" />
    </td>
    <td class="answer-cell @(game.SetCssClass(game.City!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.City.Answer @bind-value:event="oninput"
               aria-label="@string.Format(L["GameRow_InputAriaLabel"]!, L["Location_City"].Value, game.Letter)" style="width:120px;" />
        <AnswerActions Location="game.City" Answer="@game.City.Answer" MapsUri="game.City.MapsUri" />
    </td>
    <td class="answer-cell @(game.SetCssClass(game.Village!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.Village.Answer @bind-value:event="oninput"
               aria-label="@string.Format(L["GameRow_InputAriaLabel"]!, L["Location_Village"].Value, game.Letter)" style="width:120px;" />
        <AnswerActions Location="game.Village" Answer="@game.Village.Answer" MapsUri="game.Village.MapsUri" />
    </td>
    <td class="answer-cell @(game.SetCssClass(game.Country!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.Country.Answer @bind-value:event="oninput"
               aria-label="@string.Format(L["GameRow_InputAriaLabel"]!, L["Location_Country"].Value, game.Letter)" style="width:120px;" />
        <AnswerActions Location="game.Country" Answer="@game.Country.Answer" MapsUri="game.Country.MapsUri" />
    </td>
    <td class="answer-cell @(game.SetCssClass(game.River!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.River.Answer @bind-value:event="oninput"
               aria-label="@string.Format(L["GameRow_InputAriaLabel"]!, L["Location_River"].Value, game.Letter)" style="width:120px;" />
        <AnswerActions Location="game.River" Answer="@game.River.Answer" MapsUri="game.River.MapsUri" PopoverLeft="true" />
    </td>
    <td class="answer-cell @(game.SetCssClass(game.Mountain!.Points))">
        <input disabled=@(game.IsFinished || IsChecking) @bind-value=@game.Mountain.Answer @bind-value:event="oninput"
               aria-label="@string.Format(L["GameRow_InputAriaLabel"]!, L["Location_Mountain"].Value, game.Letter)" style="width:120px;" />
        <AnswerActions Location="game.Mountain" Answer="@game.Mountain.Answer" MapsUri="game.Mountain.MapsUri" PopoverLeft="true" />
    </td>
    <td class="table-light game-check-cell">
        <button @onclick="HandleClick"
                disabled=@(game.IsFinished || IsChecking)
                class="btn @(game.IsFinished ? "btn-secondary" : "btn-primary") game-check-btn"
                aria-label="@(game.IsFinished
                    ? string.Format(L["GameRow_CheckedAriaLabel"]!, game.Letter, game.SecondsPlayed)
                    : string.Format(L["GameRow_CheckAriaLabel"]!, game.Letter))">
            @if (game.IsFinished)
            {
                @string.Format(L["GameRow_CheckedButton"]!, game.SecondsPlayed)
            }
            else
            {
                @L["GameRow_CheckButton"]
            }
        </button>
    </td>
</tr>

@code {
    [Parameter] public EventCallback<Game> OnClick { get; set; }
    [Parameter] public Guid Id { get; set; }
    [Parameter] public DateTime DatePlayed { get; set; }
    [Parameter] public char Letter { get; set; }
    [Parameter] public GameLocation? City { get; set; }
    [Parameter] public GameLocation? Village { get; set; }
    [Parameter] public GameLocation? Country { get; set; }
    [Parameter] public GameLocation? Mountain { get; set; }
    [Parameter] public GameLocation? River { get; set; }
    [Parameter] public bool IsFinished { get; set; }
    [Parameter] public bool IsChecking { get; set; }
    [Parameter] public int SecondsPlayed { get; set; }

    private Game game = new();

    private async Task HandleClick() => await OnClick.InvokeAsync(game);

    protected override void OnParametersSet()
    {
        game = new Game
        {
            Id = Id,
            DatePlayed = DatePlayed,
            Letter = Letter,
            City = City,
            Village = Village,
            Country = Country,
            Mountain = Mountain,
            River = River,
            IsFinished = IsFinished,
            SecondsPlayed = SecondsPlayed
        };
    }
}
