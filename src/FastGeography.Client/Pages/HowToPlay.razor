@page "/how-to-play"
@using FastGeography.Shared
@inject IStringLocalizer<UiStrings> L

<PageTitle>@L["HowTo_PageTitle"]</PageTitle>

<div class="container py-4 how-to-play" style="max-width:720px">
    <h1 class="h2 mb-2">@L["HowTo_Heading"]</h1>
    <p class="text-muted mb-4">@L["HowTo_Intro"]</p>

    <section class="mb-5" aria-labelledby="howto-round">
        <h2 id="howto-round" class="h4">@L["HowTo_RoundHeading"]</h2>
        <p>@string.Format(L["HowTo_RoundDesc"]!, ScoringRules.DefaultTimerSeconds)</p>

        <h3 class="h6 text-muted mt-3">@L["HowTo_ScoringHeading"]</h3>
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["HowTo_ScoringColResult"]</th>
                    <th class="text-end">@L["HowTo_ScoringColPoints"]</th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-success">
                    <td>@L["HowTo_ScoringValid"]</td>
                    <td class="text-end fw-bold">+@ScoringRules.ValidPoints</td>
                </tr>
                <tr class="table-light">
                    <td>@L["HowTo_ScoringBlank"]</td>
                    <td class="text-end">@ScoringRules.EmptyPoints</td>
                </tr>
                <tr class="table-danger">
                    <td>@L["HowTo_ScoringInvalid"]</td>
                    <td class="text-end">@ScoringRules.InvalidPoints</td>
                </tr>
                <tr class="table-danger">
                    <td>@L["HowTo_ScoringWrongLetter"]</td>
                    <td class="text-end">@ScoringRules.WrongLetterPoints</td>
                </tr>
            </tbody>
        </table>
        <p class="small text-muted mb-0">@L["HowTo_StoriesNote"]</p>
    </section>

    <section aria-labelledby="howto-modes">
        <h2 id="howto-modes" class="h4 mb-3">@L["HowTo_ModesHeading"]</h2>

        <div class="row g-3">
            <div class="col-md-12">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">
                            <span class="oi oi-play-circle me-1" aria-hidden="true"></span>
                            @L["HowTo_CasualTitle"]
                        </h3>
                        <p class="card-text text-muted">@L["HowTo_CasualDesc"]</p>
                        <a href="/fastgeography" class="btn btn-primary btn-sm">@L["HowTo_CasualPlayBtn"]</a>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">
                            <span class="oi oi-star me-1" aria-hidden="true"></span>
                            @L["HowTo_RankedTitle"]
                        </h3>
                        <p class="card-text text-muted">@L["HowTo_RankedDesc"]</p>
                        <AuthorizeView>
                            <Authorized>
                                <a href="/ranked" class="btn btn-success btn-sm">@L["HowTo_RankedPlayBtn"]</a>
                            </Authorized>
                            <NotAuthorized>
                                <a href="/login?returnUrl=%2Franked" class="btn btn-outline-success btn-sm">@L["HowTo_SignInToPlay"]</a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">
                            <span class="oi oi-people me-1" aria-hidden="true"></span>
                            @L["HowTo_MultiTitle"]
                        </h3>
                        <p class="card-text text-muted">@string.Format(L["HowTo_MultiDesc"]!, ScoringRules.SetSize)</p>
                        <AuthorizeView>
                            <Authorized>
                                <a href="/multiplayer" class="btn btn-warning btn-sm">@L["HowTo_MultiPlayBtn"]</a>
                            </Authorized>
                            <NotAuthorized>
                                <a href="/login?returnUrl=%2Fmultiplayer" class="btn btn-outline-warning btn-sm">@L["HowTo_SignInToPlay"]</a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
